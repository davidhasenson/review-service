apiVersion: apps/v1
kind: Deployment
metadata:
  name: review-db
spec:
  replicas: 1
  selector:
    matchLabels:
      app: review-db
  template:
    metadata:
      labels:
        app: review-db
    spec:
      containers:
        - name: mysql
          image: mysql:8
          env:
            - name: MYSQL_ROOT_PASSWORD
              value: root
            - name: MYSQL_DATABASE
              value: reviewdb
          ports:
            - containerPort: 3306

---

apiVersion: v1
kind: Service
metadata:
  name: review-db
spec:
  selector:
    app: review-db
  ports:
    - port: 3306
      targetPort: 3306

